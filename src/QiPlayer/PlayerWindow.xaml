<ui:FluentWindow x:Class="QiPlayer.PlayerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 xmlns:vm="clr-namespace:QiPlayer.ViewModels"
                 xmlns:models="clr-namespace:QiPlayer.Models"
                 xmlns:controls="clr-namespace:QiPlayer.Controls"
                 xmlns:conv="clr-namespace:QiPlayer.Converters"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="QiPlayer"
                 Height="900" Width="600"
                 MinHeight="540" MinWidth="520"
                 WindowStartupLocation="Manual"
                 Left="0" Top="0"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 d:DataContext="{d:DesignInstance vm:PlayerViewModel}">

    <!--
      ═══════════════════════════════════════════════════════════════
      主窗口布局
      ═══════════════════════════════════════════════════════════════

      视觉语言参考 Fluent 2 / Windows 11 播放器：
        · 底色由当前封面的模糊光晕自绘；窗口的 Mica 在加载后被关掉，
          让卡片圆角外侧能真的透出桌面（见 PlayerWindow.xaml.cs）
        · 强调色随封面主色变化，出现在播放按钮、进度、当前歌词行上

      三个面板现在是三个独立窗口，彼此间隔 2px 露出桌面：
        左  歌词     —— Windows/LyricsWindow
        中  正在播放 —— 本窗口（唯一带最小化 / 最大化 / 关闭的窗口）
        右  播放列表 —— Windows/PlaylistWindow

      中栏按钮负责显示/隐藏左右两栏；左右窗口跟随本窗口移动与改高。

      播放控制放在中栏卡片内（而非底部横条），
      这样进度/控制/曲目信息属于同一个视觉单元，与参考图一致。
    -->

    <!--
      顶层：模糊封面背景 + 正在播放卡片。
      卡片圆角外的形状交给窗口区域去挖，窗口外的那一小块直接是桌面。
    -->
    <Grid x:Name="RootLayout">

        <!-- ═══════════ 封面光晕背景 ═══════════ -->
        <!--
          三栏共用同一张背景：本窗口只画「中栏」那一段，
          整组的宽高与偏移由 UpdateSideWindows 算好后写入（见 Controls/AmbientBackground）。

          这一层铺满整个卡片矩形、不裁圆角：窗口里没绘制的像素会被合成成黑色，
          裁剪出来的圆角边缘会变成一圈黑边。圆角形状由窗口区域负责（见 CardWindowChrome），
          这层只提供实色底，让卡片自身的抗锯齿边缘落在实色上。
        -->
        <controls:AmbientBackground x:Name="AmbientLayer" />

        <!-- ═══════════ 正在播放卡片 ═══════════ -->
        <!--
          中栏现在是一个独立窗口，整窗就是一张卡片：
          背景层只画在卡片范围内，卡片圆角外侧透出桌面。
          歌词与播放列表拆成了各自的窗口（见 Windows/LyricsWindow、Windows/PlaylistWindow），
          由本窗口负责定位、跟随移动与显隐。
        -->
        <Border x:Name="CoverCard" Style="{StaticResource SeamlessCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 标题栏（拖动 + 窗口按钮） -->
                    <RowDefinition Height="*" />
                    <!-- 封面 + 信息 + 控制 -->
                </Grid.RowDefinitions>

                <!--
                  标题栏：参考稿把它放在中栏内部，左侧是应用名与当前曲目，
                  右侧是最小化 / 最大化 / 关闭。
                  用 ui:TitleBar 保留 WPF-UI 的窗口拖动与系统按钮行为，
                  只把标题内容换成「QiPlayer · 曲目」。
                -->
                <!--
                  设置面板打开时把标题栏藏起来：WPF-UI 的 TitleBar 画在窗口 caption 层，
                  普通的覆盖层（即使 ZIndex 更高）遮不住它，顶部会留下一条亮色缺口。

                  用 Hidden 而不是 Collapsed：Collapsed 会连它占的 33 DIP 一起抽掉，
                  下面那一行（封面 + 信息 + 控制）就整体往上顶一格——
                  表现为「打开设置，封面突然往上跳」。Hidden 只是不画，位置仍保留。
                -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:TitleBar Title="QiPlayer"
                                 Height="32"
                                 Icon="{ui:ImageIcon 'pack://application:,,,/Assets/AppIcon.png'}"
                                 ShowMinimize="True"
                                 ShowMaximize="True"
                                 ShowClose="True">
                        <ui:TitleBar.TrailingContent>
                            <!--
                              只保留设置按钮，并做成与右侧系统按钮同款（方角、同宽高），
                              紧挨在最小化左侧，看起来是同一组窗口按钮。
                            -->
                            <Button Command="{Binding OpenSettingsCommand}"
                                    Style="{StaticResource TitleBarWindowButtonStyle}"
                                    ToolTip="设置">
                                <!-- 字号对齐系统按钮的字形尺寸（实测 16px @150%），
                                     比 12 略大一档，齿轮的视觉重量才和旁边一致 -->
                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" />
                            </Button>
                        </ui:TitleBar.TrailingContent>
                    </ui:TitleBar>
                </Border>

                <!-- 正在播放主体 -->
                <ScrollViewer x:Name="NowPlayingScroll"
                              Grid.Row="1"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{StaticResource PanePadding}">
                    <!--
                      这里不再给整块内容设最大宽度：宽度交给封面自己管（见 CoverHost 的 MaxWidth），
                      信息 / 进度 / 控制都跟着封面的实际宽度走，封面放大时它们一起变宽并保持居中。
                    -->
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 封面 -->
                            <RowDefinition Height="Auto" />
                            <!-- 曲目信息 + 标签 -->
                            <RowDefinition Height="Auto" />
                            <!-- 进度 -->
                            <RowDefinition Height="Auto" />
                            <!-- 控制（单排：文件夹 / 上一首 / 播放 / 下一首 / 循环） -->
                            <RowDefinition Height="Auto" />
                            <!-- 音量 -->
                        </Grid.RowDefinitions>

                        <!--
                          封面：保持正方形，宽度撑满内容区（上限 500）。
                          右下角叠一个播放中的频谱徽标，与参考稿一致。
                        -->
                        <!--
                          封面边长由 CoverSide 决定（见 PlayerWindow.xaml.cs）：
                          普通窗口固定 500，最大化时按可用宽高取小值，封面跟着变大。
                        -->
                        <Grid x:Name="CoverHost"
                              Grid.Row="0"
                              MaxWidth="{Binding CoverSide, RelativeSource={RelativeSource AncestorType=Window}}"
                              HorizontalAlignment="Center">
                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
                            <!--
                              底图按 500 画，再由 Uniform 等比缩放到容器宽度：
                              窗口收窄时缩小，最大化时放大（StretchDirection=Both）。
                            -->
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Grid Width="500" Height="500">
                                    <!-- 投影层：单独一层，避免阴影跟着封面一起被裁剪 -->
                                    <Border CornerRadius="8"
                                            Background="#01000000"
                                            Effect="{StaticResource CoverShadow}" />

                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                            <Border Background="{DynamicResource CardBackgroundSubtleBrush}" />

                                            <ui:SymbolIcon Symbol="MusicNote224"
                                                           FontSize="56" Opacity="0.18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasAlbumCover, Converter={StaticResource BoolToVisibilityInverseConverter}}" />

                                            <Image Source="{Binding AlbumCover}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasAlbumCover, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <!-- 切歌时淡入，避免封面硬切 -->
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1"
                                                                                         Duration="0:0:0.35" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <!-- 封面内描边：让浅色封面与卡片底之间有分界 -->
                                    <Border CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#1AFFFFFF"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </Viewbox>

                            <!-- 播放中的频谱徽标：仅播放时淡入 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,12,12"
                                    CornerRadius="6"
                                    Padding="7,5"
                                    Background="#8C141414"
                                    BorderBrush="#2EFFFFFF"
                                    BorderThickness="1"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal"
                                            Height="12"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="BadgeEq">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="1"
                                                                                 Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="BadgeEq" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border Width="3" Height="5" CornerRadius="1.5" Margin="0,0,2.5,0"
                                            VerticalAlignment="Bottom" Background="White" />
                                    <Border Width="3" Height="10" CornerRadius="1.5" Margin="0,0,2.5,0"
                                            VerticalAlignment="Bottom" Background="White" />
                                    <Border Width="3" Height="7" CornerRadius="1.5" Margin="0,0,2.5,0"
                                            VerticalAlignment="Bottom" Background="White" />
                                    <Border Width="3" Height="9" CornerRadius="1.5"
                                            VerticalAlignment="Bottom" Background="White" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--
                          曲目信息 / 进度 / 音量统一按封面的实际宽度居中，
                          左边缘因此与封面左边缘对齐；窗口变窄时封面缩小，这几块跟着收。
                        -->
                        <StackPanel Grid.Row="1" Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    Width="{Binding ActualWidth, ElementName=CoverHost}">
                            <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue='未选择曲目'}"
                                       FontSize="21" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding CurrentSong.DisplayArtist}"
                                       FontSize="14"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentSong.DisplayAlbum}"
                                       FontSize="12.5"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 进度 -->
                        <Grid Grid.Row="2" Margin="0,20,0,0"
                              HorizontalAlignment="Center"
                              Width="{Binding ActualWidth, ElementName=CoverHost}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                              点击轨道也需要寻址：Slider 的 IsMoveToPointEnabled 会改 Value，
                              但 Value 是 OneWay 绑定，ticker 每 100ms 会把它拉回播放位置，
                              所以点击期间同样进入「用户寻址」状态，抬起时再真正 seek。
                            -->
                            <Slider x:Name="ProgressSlider"
                                    Style="{StaticResource SeekSliderStyle}"
                                    Minimum="0"
                                    Maximum="{Binding DurationSeconds}"
                                    Value="{Binding PositionSeconds, Mode=OneWay}"
                                    IsMoveToPointEnabled="True"
                                    Thumb.DragStarted="ProgressSlider_DragStarted"
                                    Thumb.DragCompleted="ProgressSlider_DragCompleted" />

                            <Grid Grid.Row="1" Margin="0,1,0,0">
                                <TextBlock Text="{Binding PositionText}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding DurationText}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <!--
                          播放控制：打开文件夹 / 上一首 / 播放 / 下一首 / 循环方式，
                          全部收在一排里，播放键仍是唯一的强调色圆按钮。
                          快进、快退、停止不再单独占用位置。
                        -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Click="OpenFolder_Click"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="打开文件夹"
                                        Margin="8,0">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" />
                                </Button>

                                <Button Command="{Binding PlayPreviousCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="上一曲"
                                        Margin="8,0">
                                    <ui:SymbolIcon Symbol="Previous24" FontSize="20" />
                                </Button>

                                <Button Command="{Binding PlayPauseCommand}"
                                        Style="{StaticResource PlayButtonStyle}"
                                        Margin="12,0"
                                        ToolTip="播放 / 暂停">
                                    <Grid Width="24" Height="24">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="22"
                                                       Foreground="{DynamicResource AppAccentOnAccentBrush}"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                        <ui:SymbolIcon Symbol="Pause24" FontSize="22"
                                                       Foreground="{DynamicResource AppAccentOnAccentBrush}"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>

                                <Button Command="{Binding PlayNextCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="下一曲"
                                        Margin="8,0">
                                    <ui:SymbolIcon Symbol="Next24" FontSize="20" />
                                </Button>

                                <Button Command="{Binding CycleRepeatModeCommand}"
                                        ToolTip="{Binding RepeatModeTip}"
                                        Margin="8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Style.Triggers>
                                                <!-- 单曲循环 / 无序播放时点亮 -->
                                                <DataTrigger Binding="{Binding RepeatMode}" Value="LoopTrack">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RepeatMode}" Value="Shuffle">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <ui:SymbolIcon FontSize="20"
                                                   Symbol="{Binding RepeatMode, Converter={StaticResource RepeatModeIconConverter}}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--
                          音量行：歌词栏开关 · 静音 · 短滑条 · 百分比 · 列表开关。
                          音量条固定宽度而不是铺满整行：这一行是次要控制，
                          收短后两侧按钮才有位置，视觉重心仍在中栏。
                          整行按 1.15 倍左右放大，两侧留白对称，保证行本身的
                          几何中心仍然落在中栏中心线上。
                        -->
                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,18,0,0">

                            <!-- 左：显示 / 隐藏歌词栏 -->
                            <Button Command="{Binding ToggleLyricsCommand}"
                                    Width="34" Height="34"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    ToolTip="显示 / 隐藏歌词栏">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <!-- 文本页图标表示歌词；开关状态由颜色（强调色 / 次要色）区分 -->
                                <ui:SymbolIcon Symbol="DocumentText20" FontSize="18" />
                            </Button>

                            <Button Command="{Binding ToggleMuteCommand}"
                                    ToolTip="{Binding VolumeTip}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="34" Height="34"
                                    Padding="0">
                                <ui:SymbolIcon FontSize="18">
                                    <ui:SymbolIcon.Symbol>
                                        <MultiBinding Converter="{StaticResource VolumeIconConverter}">
                                            <Binding Path="Volume" />
                                            <Binding Path="IsMuted" />
                                        </MultiBinding>
                                    </ui:SymbolIcon.Symbol>
                                </ui:SymbolIcon>
                            </Button>

                            <Slider x:Name="VolumeSlider"
                                    Style="{StaticResource VolumeSliderStyle}"
                                    Minimum="0" Maximum="1"
                                    TickFrequency="0.01"
                                    Width="170"
                                    Margin="6,0,12,0"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True"
                                    ToolTip="{Binding VolumeText}" />

                            <TextBlock Text="{Binding VolumeText}"
                                       FontSize="{StaticResource BodyFontSize}"
                                       VerticalAlignment="Center"
                                       Width="38"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" />

                            <!-- 右：显示 / 隐藏播放列表 -->
                            <Button Command="{Binding TogglePlaylistCommand}"
                                    Width="34" Height="34"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    ToolTip="显示 / 隐藏播放列表">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaylistVisible}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <!-- 项目符号列表表示播放列表；开关状态同样由颜色区分 -->
                                <ui:SymbolIcon Symbol="TextBulletListLtr20" FontSize="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════ 设置面板（覆盖层，不新开窗口） ═══════════ -->
        <!--
          参考 Fluent 2 设置页：一页到底，纵向滚动（不再分左侧导航）。
          各分区共用同一套视觉：分区标题、卡片标题、行（左标题说明、右控件），
          行与行之间由 SettingsRow 模板画 1px 分隔线。
        -->
        <Grid Panel.ZIndex="10"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#66000000" MouseLeftButtonDown="SettingsBackdrop_MouseLeftButtonDown" />

            <Grid Margin="28">
                <Border Width="840" Height="680"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource SettingsOverlayCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ────── 标题栏 ────── -->
                        <!--
                          标题栏底色是铺满整宽的，必须自己把上面两个角倒成圆角：
                          卡片的 ClipToBounds 只能按矩形裁，方角会填进卡片圆角里，
                          连 DropShadowEffect 也会跟着投出一个方角阴影。
                          半径 = 卡片 12 − 描边 1。
                        -->
                        <Border Grid.Row="0"
                                Height="46"
                                CornerRadius="11,11,0,0"
                                Background="{DynamicResource CardBackgroundSubtleBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="16,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AppAccentBrush}" />
                                    <TextBlock Text="设置"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ui:Button Command="{Binding CloseSettingsCommand}"
                                           Appearance="Transparent"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="6"
                                           ToolTip="关闭设置">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!-- ────── 内容（单页滚动，不再分左右两栏） ────── -->
                        <Grid Grid.Row="1">
                            <ScrollViewer Padding="30,26,34,40"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <!--
                                  所有卡片顺序排在一页里，只用卡片之间的留白分组：
                                  间距统一由 SettingsCardStyle 的下边距提供（18），
                                  这里不再给分组加额外外边距，否则跨分组的空隙会比组内大一截。
                                -->
                                <StackPanel>
                                    <!-- ═══════════ 外观 ═══════════ -->
                                    <StackPanel x:Name="SettingsPageSystem">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="外观" />
                                                <controls:SettingsRow Header="专辑封面背景"
                                                                      Description="用当前封面作为主界面左栏的背景"
                                                                      IsFirst="True">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.AlbumArtBackground, Mode=TwoWay}" />
                                                </controls:SettingsRow>

                                                <StackPanel IsEnabled="{Binding Settings.AlbumArtBackground}">
                                                    <controls:SettingsRow Header="背景高斯模糊">
                                                        <ui:ToggleSwitch IsChecked="{Binding Settings.AlbumArtBackgroundBlur, Mode=TwoWay}" />
                                                    </controls:SettingsRow>
                                                    <controls:SettingsRow Header="模糊半径"
                                                                          IsEnabled="{Binding Settings.AlbumArtBackgroundBlur}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Slider Width="260"
                                                                    Style="{StaticResource SettingsSliderStyle}"
                                                                    Minimum="0" Maximum="100"
                                                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                                                    Value="{Binding Settings.AlbumArtBackgroundBlurRadius, Mode=TwoWay}" />
                                                            <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                       Text="{Binding Settings.AlbumArtBackgroundBlurRadius, StringFormat={}{0:0} px}" />
                                                        </StackPanel>
                                                    </controls:SettingsRow>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ═══════════ 歌词 ═══════════ -->
                                    <StackPanel x:Name="SettingsPageLyrics">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="应用内歌词" />
                                                <controls:SettingsRow Header="字号" IsFirst="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="12" Maximum="32"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.LyricFontSize, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.LyricFontSize, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="行距">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="0" Maximum="40"
                                                                TickFrequency="2" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.LyricLineSpacing, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.LyricLineSpacing, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="字体"
                                                                      Description="留空表示跟随应用字体">
                                                    <ComboBox x:Name="LyricFontComboBox"
                                                              MinWidth="230" FontSize="13"
                                                              SelectedValuePath="Tag"
                                                              SelectedValue="{Binding Settings.LyricFontFamily, Mode=TwoWay}"
                                                              IsVisibleChanged="LyricFontComboBox_IsVisibleChanged"
                                                              DropDownOpened="LyricFontComboBox_DropDownOpened" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="恢复默认"
                                                                      Description="字号 18、行距 14、字体跟随应用">
                                                    <ui:Button Content="恢复默认"
                                                               Appearance="Secondary"
                                                               Click="ResetLyricSettings_Click" />
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ═══════════ 媒体 Flyout ═══════════ -->
                                    <StackPanel x:Name="SettingsPageFlyout">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="媒体面板" />
                                                <controls:SettingsRow Header="媒体 Flyout"
                                                                      Description="启用浮动媒体面板"
                                                                      IsFirst="True">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.MediaFlyoutEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="标题居中"
                                                                      Description="标题与艺术家水平居中">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.CenterTitleArtist, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="显示进度条">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.SeekbarEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="停留时长"
                                                                      Description="浮出后自动隐藏的等待时间">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="500" Maximum="10000"
                                                                TickFrequency="500" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.Duration, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.Duration, StringFormat={}{0:0} ms}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="动画速度">
                                                    <ComboBox MinWidth="230" FontSize="13"
                                                              SelectedIndex="{Binding Settings.FlyoutAnimationSpeed, Mode=TwoWay}">
                                                        <ComboBoxItem Content="关闭动画" />
                                                        <ComboBoxItem Content="0.5 倍" />
                                                        <ComboBoxItem Content="1 倍（默认）" />
                                                        <ComboBoxItem Content="1.5 倍" />
                                                        <ComboBoxItem Content="2 倍" />
                                                        <ComboBoxItem Content="3 倍" />
                                                    </ComboBox>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="缓动曲线">
                                                    <ComboBox MinWidth="230" FontSize="13"
                                                              SelectedIndex="{Binding Settings.FlyoutAnimationEasingStyle, Mode=TwoWay}">
                                                        <ComboBoxItem Content="线性" />
                                                        <ComboBoxItem Content="正弦" />
                                                        <ComboBoxItem Content="二次" />
                                                        <ComboBoxItem Content="三次（默认）" />
                                                    </ComboBox>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="目标显示器"
                                                                      Description="多显示器时，Flyout 出现的屏幕">
                                                    <ComboBox x:Name="FlyoutMonitorComboBox"
                                                              MinWidth="230" FontSize="13"
                                                              SelectedIndex="{Binding Settings.FlyoutSelectedMonitor, Mode=TwoWay}"
                                                              DropDownOpened="FlyoutMonitorComboBox_DropDownOpened" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="背景模糊"
                                                                      Description="面板背后的模糊样式">
                                                    <ComboBox MinWidth="230" FontSize="13"
                                                              SelectedIndex="{Binding Settings.MediaFlyoutBackgroundBlur, Mode=TwoWay}">
                                                        <ComboBoxItem Content="关闭" />
                                                        <ComboBoxItem Content="样式 1" />
                                                        <ComboBoxItem Content="样式 2" />
                                                        <ComboBoxItem Content="样式 3" />
                                                    </ComboBox>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="亚克力背景"
                                                                      Description="面板使用系统亚克力材质">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.MediaFlyoutAcrylicWindowEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ═══════════ 任务栏 ═══════════ -->
                                    <StackPanel x:Name="SettingsPageTaskbar">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="任务栏挂件" />
                                                <controls:SettingsRow Header="任务栏挂件"
                                                                      Description="在任务栏上显示当前曲目"
                                                                      IsFirst="True">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarWidgetEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="目标显示器"
                                                                      Description="多显示器时，挂件出现的屏幕">
                                                    <ComboBox x:Name="TaskbarMonitorComboBox"
                                                              MinWidth="230" FontSize="13"
                                                              SelectedIndex="{Binding Settings.TaskbarWidgetSelectedMonitor, Mode=TwoWay}"
                                                              DropDownOpened="TaskbarMonitorComboBox_DropDownOpened" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="水平偏移"
                                                                      Description="在锚定位置的基础上左右微调">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="-100" Maximum="300"
                                                                TickFrequency="2" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarWidgetManualPadding, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarWidgetManualPadding, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="长标题滚动"
                                                                      Description="标题超出宽度时持续横向滚动">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarWidgetScrollingEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="循环滚动"
                                                                      Description="滚到末尾后从头继续，而不是来回摆动">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarWidgetScrollingTextLoopForever, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="滚动速度">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="5" Maximum="60"
                                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarWidgetScrollingTextSpeed, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarWidgetScrollingTextSpeed}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="任务栏歌词" />
                                                <controls:SettingsRow Header="任务栏歌词"
                                                                      Description="只显示当前一行歌词，不显示译文行"
                                                                      IsFirst="True">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarLyricsEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="歌词最大宽度"
                                                                      Description="歌词过长时截断，不挤压其它图标">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="120" Maximum="800"
                                                                TickFrequency="20" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarLyricsMaxWidth, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarLyricsMaxWidth, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="歌词字号">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="10" Maximum="30"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarLyricsFontSize, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarLyricsFontSize, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="歌词字体"
                                                                      Description="留空表示跟随应用字体">
                                                    <ComboBox x:Name="TaskbarLyricsFontComboBox"
                                                              MinWidth="230" FontSize="13"
                                                              SelectedValuePath="Tag"
                                                              SelectedValue="{Binding Settings.TaskbarLyricsFontFamily, Mode=TwoWay}"
                                                              IsVisibleChanged="TaskbarLyricsFontComboBox_IsVisibleChanged"
                                                              DropDownOpened="TaskbarLyricsFontComboBox_DropDownOpened" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="卡拉 OK 逐字填充"
                                                                      Description="已唱部分按强调色逐字填充">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarLyricsKaraokeEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="任务栏频谱" />
                                                <controls:SettingsRow Header="任务栏频谱"
                                                                      Description="在挂件左侧显示实时频谱"
                                                                      IsFirst="True">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarVisualizerEnabled, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="频谱柱数">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="1" Maximum="20"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarVisualizerBarCount, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarVisualizerBarCount}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="频谱宽度">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Slider Width="260"
                                                                Style="{StaticResource SettingsSliderStyle}"
                                                                Minimum="60" Maximum="240"
                                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                                Value="{Binding Settings.TaskbarVisualizerWidth, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource SettingsValueTextStyle}"
                                                                   Text="{Binding Settings.TaskbarVisualizerWidth, StringFormat={}{0:0} px}" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="居中对称">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarVisualizerCenteredBars, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                                <controls:SettingsRow Header="显示基线">
                                                    <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarVisualizerBaseline, Mode=TwoWay}" />
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ═══════════ 配置文件（收在最下面） ═══════════ -->
                                    <StackPanel x:Name="SettingsPageConfig">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="配置文件" />
                                                <controls:SettingsRow IsFirst="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Button Content="导入…"
                                                                   Appearance="Secondary"
                                                                   Margin="0,0,8,0"
                                                                   Click="ImportSettings_Click" />
                                                        <ui:Button Content="导出…"
                                                                   Appearance="Secondary"
                                                                   Click="ExportSettings_Click" />
                                                    </StackPanel>
                                                </controls:SettingsRow>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 托盘图标 -->
        <tray:NotifyIcon x:Name="TrayIcon"
                         Icon="pack://application:,,,/Assets/TrayIcon.png"
                         TooltipText="QiPlayer"
                         MenuOnRightClick="True"
                         LeftClick="TrayIcon_LeftClick"
                         FocusOnLeftClick="False"
                         Visibility="Collapsed">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <ui:MenuItem Header="显示主窗口" Click="TrayShow_Click">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Window20" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator />
                    <ui:MenuItem Header="播放 / 暂停" Click="TrayPlayPause_Click">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Play20" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="上一曲" Click="TrayPrevious_Click">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Previous20" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="下一曲" Click="TrayNext_Click">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Next20" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator />
                    <ui:MenuItem Header="退出" Click="TrayExit_Click">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowExit20" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
