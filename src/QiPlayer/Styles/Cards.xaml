<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ═══════════════════════════════════════════════════════════
      卡片与基础控件样式
      ═══════════════════════════════════════════════════════════

      与 DesignTokens.xaml 的分工：
        · DesignTokens 只放数值/颜色
        · 本文件放「长什么样」——卡片容器、按钮、滑块、药丸标签
        · PlayerWindow 只放「放在哪」

      所有尺寸都从 DesignTokens 取值；颜色用 DynamicResource，
      因此主题切换与切歌换强调色都不需要重建界面。
    -->

    <!-- ═══════════ 亚克力卡片 ═══════════ -->

    <!--
      三栏面板的容器。参考实现里是 .panel：
      半透明底 + 1px 描边 + 10px 圆角 + 柔和投影。
    -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <!-- 内容可能在圆角外绘制，必须裁剪 -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
      主界面三栏卡片：圆角 + 亚克力底色 + 1px 细描边，但不投影。
      三张卡片现在是彼此独立的圆角面板，栏间缝隙透出桌面，
      描边负责在任何壁纸上勾出面板轮廓；投影会在 2px 缝隙里糊成一条灰带，
      反而不像「透过去」，所以去掉。
    -->
    <Style x:Key="SeamlessCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
        <Setter Property="Effect" Value="{x:Null}" />

    </Style>

    <!-- ═══════════ 图标按钮 ═══════════ -->

    <!--
      参考实现的 .tbtn：方形圆角、透明底、悬停浮出中性色、按下轻微缩小。
      用在上一首/下一首/循环/列表开关等次要操作上。
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource AppHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource AppPressedBrush}" />
                            <!-- 按下反馈用缩放：Transform 不是命名元素，无法被 Setter 直接定位 -->
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      标题栏右侧的窗口按钮：与系统的最小化 / 最大化 / 关闭同宽同高、
      同样方角、同样是「悬停才出现灰底」的反馈，
      放在系统按钮左侧读起来就是同一组按钮，而不是一个独立的 App 按钮。
    -->
    <Style x:Key="TitleBarWindowButtonStyle" TargetType="Button">
        <!--
          尺寸与系统按钮实测一致：Wpf.Ui 的最小化 / 最大化 / 关闭是 44×30 DIP，
          上方留 1.3 DIP 的间隙。46×32 会让灰底比系统按钮高出两条，
          悬停时能看出「设置那块顶到了分隔线，其他三块下面还留白」。
        -->
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TitleBarButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TitleBarButtonPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 主播放按钮 ═══════════ -->

    <!--
      参考实现的 .play-btn：56px 圆形、强调色实心、柔和外阴影。
      这是界面上唯一的高饱和色块，用来锚定视觉中心。
    -->
    <Style x:Key="PlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentOnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Shadow"
                                 Fill="{TemplateBinding Background}"
                                 Opacity="0.45"
                                 Margin="2,6,2,-2">
                            <Ellipse.Effect>
                                <BlurEffect Radius="10" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />

                        <!-- 顶部高光，让圆球有材质感而非纯色块 -->
                        <Ellipse IsHitTestVisible="False" Margin="6,4,6,26">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill"
                                    Value="{DynamicResource AppAccentStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 药丸按钮 ═══════════ -->

    <!-- ═══════════ 滑块 ═══════════ -->

    <!--
      参考实现的进度条：4px 细轨道、已播放部分为强调色、
      拇指默认隐藏、只在悬停/拖拽时出现（音量条则常显）。

      轨道用「两层 Border 叠放」而非线性渐变：
      宽度绑定由代码在 PlaybackProgressBar 里算，避免渐变在
      半透明卡片上出现奇怪的混色。
    -->

    <!--
      轨道两侧的 RepeatButton 只负责绘制（已播放部分 / 透明底），
      不参与命中：一旦让它们吃到鼠标，ButtonBase 会把 MouseLeftButtonDown
      标记为已处理，Slider 的 IsMoveToPointEnabled（点击跳转）就永远不会执行。
      关掉命中后点击穿透到 Slider，点轨道任意位置即可跳转。
    -->
    <Style x:Key="SeekSliderRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeekSliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14">
                        <Ellipse x:Name="Dot"
                                 Fill="{DynamicResource AppAccentBrush}"
                                 Stroke="{DynamicResource CardBackgroundBrush}"
                                 StrokeThickness="2"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Setter TargetName="Dot" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Slider 模板：轨道 4px，填充部分由 Track 的 DecreaseRepeatButton 承载。
      用 Track.IsDirectionReversed=false + Decrease=已播放（强调色）的约定，
      保证从左到右填充。
    -->
    <Style x:Key="SeekSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root"
                          Background="Transparent"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource AppTrackBrush}"
                                VerticalAlignment="Center" />

                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <!-- 只读预览时仍可点击跳转：Decrease 区用强调色铺满左侧 -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SeekSliderRepeatButton}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb x:Name="SeekThumb"
                                       Style="{StaticResource SeekSliderThumb}" />
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SeekSliderRepeatButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                          悬停时整条轨道略微加粗，提示可拖动。
                          这里必须用渲染变换，不能改 Slider 的 Height：
                          模板触发器的 Height 落在控件自身上，会把控件撑高 2px，
                          整行变高，下面的进度时间与按钮跟着整体下移。
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleY="1.25" />
                                </Setter.Value>
                            </Setter>
                            <!--
                              上面的纵向放大会把圆形的拇指压成椭圆，
                              这里给拇指一个 1/1.25 的反向缩放把它“拉回来”：
                              渲染变换会层层相乘，最终拇指仍是正圆。
                              只挂在悬停状态上，拖拽时鼠标离开进度条不会留下被压扁的拇指。
                            -->
                            <Setter TargetName="SeekThumb" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter TargetName="SeekThumb" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleY="0.8" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 音量条：拇指常显、轨道更细，与进度条区分主次 -->
    <Style x:Key="VolumeSliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14">
                        <Ellipse Fill="{DynamicResource AppAccentBrush}"
                                 Stroke="{DynamicResource CardBackgroundBrush}"
                                 StrokeThickness="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VolumeSliderStyle" TargetType="Slider" BasedOn="{StaticResource SeekSliderStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource AppTrackBrush}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SeekSliderRepeatButton}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VolumeSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SeekSliderRepeatButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 搜索框 ═══════════ -->

    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{DynamicResource CardBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource CardStrokeStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <!-- 底边强调色：聚焦时浮现，与参考实现一致 -->
                        <Grid>
                            <Border x:Name="FocusLine"
                                    Height="2"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1"
                                    Background="{DynamicResource AppAccentBrush}"
                                    Opacity="0" />

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>

                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Margin="32,0,10,0"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusLine" Property="Opacity" Value="1" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource CardStrokeStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
