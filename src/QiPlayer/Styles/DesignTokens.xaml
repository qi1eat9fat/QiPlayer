<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      ═══════════════════════════════════════════════════════════
      设计令牌（Design Tokens）
      ═══════════════════════════════════════════════════════════

      这一层只定义「数值与颜色」，不含任何控件模板。
      其余样式与 PlayerWindow 都从这里取值，改一处即可整体调整。

      视觉参考：Fluent 2 的 Mica + 亚克力卡片语言
        · 背景：Mica（窗口材质本身），叠加封面模糊光晕
        · 内容：圆角 10 的亚克力面板，1px 描边 + 柔和投影
        · 强调色：随当前封面主色变化（见 Classes/AccentPalette.cs）

      颜色全部走 DynamicResource。深浅色的实际取值由 Classes/AppThemeStyler.cs
      在运行时写入应用资源（见该文件），此处的初值保证设计器中有合理预览。
    -->

    <!-- ═══════════ 间距与圆角 ═══════════ -->

    <!-- 主区域面板的内边距：内容贴到窗口边缘后，靠它维持呼吸感 -->
    <Thickness x:Key="PanePadding">24,20,24,20</Thickness>

    <!-- Fluent 2：大卡片取 8~10，控件取 4~6 -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <!-- ═══════════ 中性色（运行时按主题覆盖） ═══════════ -->

    <!-- 卡片底色：半透明，让 Mica 与封面光晕透出来 -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundSubtleBrush" Color="#75FFFFFF" />

    <!-- 描边：低对比，只分隔层次，不做装饰 -->
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CardStrokeStrongBrush" Color="#1F000000" />

    <!-- 悬停 / 按下：叠在卡片上的中性色 -->
    <SolidColorBrush x:Key="AppHoverBrush" Color="#0C000000" />
    <SolidColorBrush x:Key="AppPressedBrush" Color="#15000000" />

    <!-- 次要 / 三级文字 -->
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8C000000" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#66000000" />

    <!-- 进度条 / 音量条的未填充轨道 -->
    <SolidColorBrush x:Key="AppTrackBrush" Color="#24000000" />

    <!--
      标题栏窗口按钮的悬停 / 按下底色。
      比 AppHoverBrush 深一档，取值对齐系统的最小化 / 最大化 / 关闭按钮
      （浅色下叠在标题栏上约 #E5E5E5），这样自定义按钮和系统按钮
      在同一排里看不出差别。
    -->
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#2E000000" />

    <!-- 设置页预览舞台：比卡片更暗一档，让预览内容像嵌在凹槽里 -->
    <SolidColorBrush x:Key="SettingsStageBrush" Color="#E4E4E4" />

    <!-- ═══════════ 强调色（运行时由 AccentPalette 覆盖） ═══════════ -->

    <!--
      初值即 AccentPalette 的默认蓝；窗口加载后由 PlayerViewModel.ApplyAccent
      按当前封面替换。控件一律用 DynamicResource 引用这五个键。
    -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#4F7FD9" />
    <SolidColorBrush x:Key="AppAccentStrongBrush" Color="#3B68C4" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#234F7FD9" />
    <SolidColorBrush x:Key="AppAccentSoftStrongBrush" Color="#404F7FD9" />
    <SolidColorBrush x:Key="AppAccentOnAccentBrush" Color="#FFFFFFFF" />

    <!-- ═══════════ 歌词卡拉OK 配色 ═══════════ -->

    <!--
      任务栏挂件与左栏歌词共用这一套：未唱深绿、已唱橙。
      两处必须同源，否则同一个「参考任务栏」的效果会随窗口不同而变。
    -->
    <SolidColorBrush x:Key="LyricKaraokeIdleBrush" Color="#3E8E2E" />
    <SolidColorBrush x:Key="LyricKaraokeFillBrush" Color="#F2730D" />

    <!-- ═══════════ 阴影 ═══════════ -->

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="28"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.12"
                      RenderingBias="Quality" />

    <DropShadowEffect x:Key="CoverShadow"
                      BlurRadius="36"
                      ShadowDepth="6"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.28"
                      RenderingBias="Quality" />

    <!-- ═══════════ 字体与字号 ═══════════ -->

    <!-- Win11 有 Segoe UI Variable，Win10 回退 Segoe UI；FontFamily 支持候选列表 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>

</ResourceDictionary>
