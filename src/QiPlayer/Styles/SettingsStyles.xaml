<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QiPlayer.Controls">

    <!--
      ═══════════════════════════════════════════════════════════
      设置界面样式
      ═══════════════════════════════════════════════════════════

      视觉参考：Fluent 2 设置页（左侧导航 + 卡片 / 行）。
        · 卡片：8px 圆角、1px 描边、半透明底，行与行之间一条 1px 分隔线
        · 行：左侧标题 + 说明，右侧控件；说明用三级文字
        · 分段控件：浅槽 + 选中项浮起的白色小块
        · 滑杆：4px 轨道、强调色填充、白色圆环拇指

      尺寸与颜色尽量沿用 DesignTokens，只有预览舞台需要一档
      「比卡片更暗」的底色，单独放在 SettingsStageBrush。
    -->

    <!-- ═══════════ 设置面板容器 ═══════════ -->

    <!--
      覆盖层卡片：整块设置界面，盖在播放器之上。
      背景用 Fluent 的基础填充色（不透明），否则背景的封面光晕会透出来，
      与「一个独立的设置窗口」的观感不符。
    -->
    <Style x:Key="SettingsOverlayCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />

        <!-- 贴边的内容靠裁剪收在卡片内；圆角要元素自己倒（矩形裁剪不会倒角） -->
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════ 卡片 ═══════════ -->

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <!-- 预览舞台要贴到卡片底边，靠裁剪把它的方角收进圆角里 -->
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SettingsCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsCardTitleTextStyle}">
        <Setter Property="Margin" Value="20,15,20,3" />
    </Style>

    <!-- ═══════════ 设置行 ═══════════ -->

    <!--
      隐式样式：设置页里所有 SettingsRow 直接套用，不需要逐行写 Style。
      （设置行只出现在设置面板，作用域放大到全局没有副作用。）
    -->
    <Style TargetType="{x:Type controls:SettingsRow}">
        <Setter Property="Padding" Value="20,13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsRow}">
                    <Grid>
                        <!-- 行分隔线：第一行由 IsFirst 关掉 -->
                        <Border x:Name="Separator"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource CardStrokeBrush}" />

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="Desc"
                                           Text="{TemplateBinding Description}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                            </StackPanel>

                            <ContentPresenter x:Name="Ctrl"
                                              Grid.Column="1"
                                              Margin="18,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Ctrl" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行右侧的数值标签：固定宽度，滑杆拖动时不左右跳动 -->
    <Style x:Key="SettingsValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Margin" Value="14,0,0,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>

    <!-- ═══════════ 滑杆 ═══════════ -->

    <Style x:Key="SettingsSliderRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 已填充部分：强调色细轨道 -->
    <Style x:Key="SettingsSliderFillStyle" TargetType="RepeatButton"
           BasedOn="{StaticResource SettingsSliderRepeatStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppAccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <!-- 白色圆环 + 强调色圆点：与参考稿一致 -->
                        <Ellipse Fill="#FFFFFFFF" Stroke="#22000000" StrokeThickness="1" />
                        <Ellipse Width="11" Height="11"
                                 Fill="{DynamicResource AppAccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <!-- 未填充轨道 -->
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppTrackBrush}" />

                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SettingsSliderFillStyle}" />
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource SettingsSliderThumbStyle}" />
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SettingsSliderRepeatStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
