<Window x:Class="QiPlayer.Windows.PlaylistWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:QiPlayer.ViewModels"
                 xmlns:models="clr-namespace:QiPlayer.Models"
                 xmlns:controls="clr-namespace:QiPlayer.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="播放列表"
                 Width="360" Height="760" MinWidth="300" MinHeight="540"
                 WindowStyle="None" ResizeMode="NoResize"
                 Background="Transparent"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False" ShowActivated="False"
                 d:DataContext="{d:DesignInstance vm:PlayerViewModel}">

    <!--
      右栏窗口：独立的播放列表面板。

      与中栏共用同一个 PlayerViewModel（由 PlayerWindow 在构造时注入），
      位置与高度由主窗口同步，自己没有系统标题栏按钮，
      显隐由中栏标题栏的列表按钮控制。
    -->

    <Grid x:Name="RootLayout">

                <!--
          三栏共用同一张背景：本窗口只画「左栏」那一段，
          整组的宽高与偏移由 PlayerWindow 写入（见 Controls/AmbientBackground）。
        -->
        <controls:AmbientBackground x:Name="AmbientLayer" />

        <Border x:Name="Card" Style="{StaticResource SeamlessCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 搜索 -->
                <TextBox Grid.Row="0"
                         x:Name="SearchBox"
                         Style="{StaticResource SearchBoxStyle}"
                         Margin="20,18,20,10"
                         Tag="搜索歌曲或歌手"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 列表 -->
                <ListBox Grid.Row="1"
                         x:Name="PlaylistBox"
                         ItemsSource="{Binding PlaylistView}"
                         SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,0,10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="PlaylistBox_MouseDoubleClick"
                         SelectionChanged="PlaylistBox_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AppHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AppPressedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SongItem}">
                            <Grid ToolTipService.InitialShowDelay="600"
                                  ToolTipService.ShowDuration="30000">
                                <Grid.ToolTip>
                                    <ToolTip MaxWidth="540">
                                        <TextBlock Text="{Binding DetailsText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   LineHeight="19" />
                                    </ToolTip>
                                </Grid.ToolTip>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面缩略图：无封面时显示音符占位 -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="5"
                                        ClipToBounds="True"
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource CardBackgroundSubtleBrush}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="MusicNote224"
                                                       FontSize="18" Opacity="0.25"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasCoverThumbnail, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                        <Image Source="{Binding CoverThumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasCoverThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- 标题 + 艺术家 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="13.5"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding DisplayArtist}"
                                               FontSize="12"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>

                                <!-- 时长；当前曲目换成跳动的频谱条 -->
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Visibility="{Binding DataContext.ShowDurationColumn, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DurationText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Height="14"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- 暂停时频谱条静止，播放时跳动 -->
                                                    <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EqStoryboard">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1" To="1"
                                                                                     Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EqStoryboard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Width="3" Height="6" CornerRadius="1.5" Margin="0,0,2,0"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AppAccentBrush}" />
                                        <Border Width="3" Height="12" CornerRadius="1.5" Margin="0,0,2,0"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AppAccentBrush}" />
                                        <Border Width="3" Height="9" CornerRadius="1.5"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AppAccentBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="播放" Click="MenuPlay_Click" />
                            <Separator />
                            <MenuItem Header="打开文件位置" Click="MenuOpenLocation_Click" />
                            <Separator />
                            <MenuItem Header="从列表中移除" Click="MenuRemove_Click" />
                            <MenuItem Header="从磁盘删除（移入回收站）" Click="MenuDeleteFromDisk_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- 底部合计：曲目数已显示在标题下方，这里只放合计时长 -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,9,20,14">
                    <!-- 左：曲目数量（搜索时为「共 N 首 · 匹配 M 首」）；右：可见曲目的合计时长 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding ListStatus}"
                                   FontSize="12"
                                   Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ListDurationText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
